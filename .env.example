# Existing full bundled stack (MariaDB + Redis). Other supported recipes are
# documented in README.md.
COMPOSE_PROFILES=bundled
APP_PORT=8080
APP_BIND=
TRUST_PROXY=0

DATABASE_BACKEND=mysql
REALTIME_BACKEND=redis

# MySQL/MariaDB (bundled or remote)
DB_HOST=db
DB_PORT=3306
DB_NAME=ongeki_collab
DB_USER=ongeki
DB_PASSWORD=

# Persistent SQLite (used only when DATABASE_BACKEND=sqlite)
SQLITE_PATH=/data/ongeki-collab.sqlite

# Redis (bundled or remote; unused when REALTIME_BACKEND=memory)
REDIS_URL=redis://redis:6379

# Generate each required secret with: openssl rand -base64 32
IDENTITY_HASH_SECRET=
KEY_ENCRYPTION_SECRET=
TICKET_SIGNING_SECRET=
ADMIN_RESET_SECRET=
ADMIN_INITIAL_PASSWORD=
